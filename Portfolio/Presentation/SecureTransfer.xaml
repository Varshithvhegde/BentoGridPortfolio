<UserControl
    x:Class="Portfolio.Presentation.SecureTransfer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="300"
    d:DesignWidth="300">

    <Grid Background="Transparent">
        <!-- Background Particles -->
        <Canvas x:Name="ParticleCanvas"/>

        <!-- Central Hub -->
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
            <!-- Rotating Shield Ring -->
            <Grid x:Name="ShieldRing" Width="100" Height="100" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <RotateTransform Angle="0"/>
                </Grid.RenderTransform>
                <Ellipse Stroke="#3B82F6" StrokeThickness="2" StrokeDashArray="4,4" Opacity="0.5"/>
            </Grid>

            <!-- Inner Pulse Circle -->
            <Ellipse x:Name="PulseCircle" Width="60" Height="60" Fill="#3B82F6" Opacity="0.2" RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Ellipse.RenderTransform>
            </Ellipse>

            <!-- Icon Container -->
            <Grid Width="60" Height="60" Background="#3B82F6" CornerRadius="30">
                <FontIcon Glyph="&#xE896;" FontFamily="Segoe MDL2 Assets" Foreground="White" FontSize="24"/> <!-- Download/Transfer Icon -->
            </Grid>
        </Grid>

        <!-- Text Overlay -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,100,0,0" Spacing="4">
            <TextBlock Text="FreeShare" 
                       FontSize="20" 
                       FontWeight="Bold" 
                       Foreground="White" 
                       HorizontalAlignment="Center"/>
            <TextBlock Text="Secure Transfer" 
                       FontSize="12" 
                       Foreground="#B8B8B8" 
                       HorizontalAlignment="Center"
                       Opacity="0.8"/>
        </StackPanel>
    </Grid>
</UserControl>
