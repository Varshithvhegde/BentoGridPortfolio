<UserControl
    x:Class="Portfolio.Presentation.InteractiveSkillSet"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="420"
    d:DesignWidth="380">

    <UserControl.Resources>
        <Storyboard x:Name="PulseStoryboard" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="GridScale" Storyboard.TargetProperty="ScaleX" From="1" To="1.05" Duration="0:0:2"/>
            <DoubleAnimation Storyboard.TargetName="GridScale" Storyboard.TargetProperty="ScaleY" From="1" To="1.05" Duration="0:0:2"/>
        </Storyboard>
    </UserControl.Resources>

    <Grid Background="Transparent">
        <Grid.Clip>
            <RectangleGeometry Rect="0,0,380,420" x:Name="ClipRect"/>
        </Grid.Clip>

        <!-- Background Particles -->
        <Canvas x:Name="ParticleCanvas" IsHitTestVisible="False"/>

        <!-- Header -->
        <StackPanel Orientation="Horizontal" Spacing="12" Margin="24,24,0,0" VerticalAlignment="Top" HorizontalAlignment="Left">
            <Border Background="#6366F1" Width="36" Height="36" CornerRadius="8">
                <FontIcon Glyph="&#xE943;" FontFamily="Segoe MDL2 Assets" Foreground="White" FontSize="18"/>
            </Border>
            <TextBlock Text="Skill Set" FontSize="22" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Main Content Area -->
        <Grid x:Name="ContentGrid" Margin="0,60,0,0">
            <Grid.Projection>
                <PlaneProjection x:Name="ChartProjection" />
            </Grid.Projection>
            
            <!-- Radar Chart -->
            <Canvas x:Name="ChartCanvas" HorizontalAlignment="Center" VerticalAlignment="Center" Width="300" Height="300">
                <!-- Background Grid -->
                <Canvas x:Name="GridCanvas">
                    <Canvas.RenderTransform>
                        <ScaleTransform x:Name="GridScale" CenterX="150" CenterY="150"/>
                    </Canvas.RenderTransform>
                </Canvas>

                <!-- Scanning Line -->
                <Grid Width="300" Height="300" IsHitTestVisible="False">
                    <Rectangle x:Name="ScanLine" Width="150" Height="2" HorizontalAlignment="Right" VerticalAlignment="Center" RenderTransformOrigin="0,0.5" Margin="150,0,0,0">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#006366F1" Offset="0"/>
                                <GradientStop Color="#806366F1" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                        <Rectangle.RenderTransform>
                            <RotateTransform x:Name="ScanRotation" CenterX="0" CenterY="0" Angle="0"/>
                        </Rectangle.RenderTransform>
                    </Rectangle>
                </Grid>
                
                <!-- Data Polygon -->
                <Polygon x:Name="DataPolygon" Fill="#4D6366F1" Stroke="#6366F1" StrokeThickness="2"/>
                
                <!-- Data Points -->
                <Canvas x:Name="PointsCanvas" />
                
                <!-- Labels -->
                <Canvas x:Name="LabelsCanvas" />

                <!-- Floating Tags -->
                <Canvas x:Name="TagsCanvas" IsHitTestVisible="False"/>
            </Canvas>
        </Grid>

        <!-- Info Overlay -->
        <Grid x:Name="InfoOverlay" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,20" Opacity="0">
            <Border Background="#CC1A1F35" CornerRadius="12" Padding="12,8" BorderBrush="#6366F1" BorderThickness="1">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock x:Name="InfoLabel" Text="Skill" Foreground="White" FontWeight="Bold"/>
                    <TextBlock x:Name="InfoValue" Text="90%" Foreground="#6366F1"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
