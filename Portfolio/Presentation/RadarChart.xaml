<UserControl
    x:Class="Portfolio.Presentation.RadarChart"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="300"
    d:DesignWidth="300">

    <UserControl.Resources>
        <Storyboard x:Name="PulseStoryboard" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="GridScale" Storyboard.TargetProperty="ScaleX" From="1" To="1.05" Duration="0:0:2"/>
            <DoubleAnimation Storyboard.TargetName="GridScale" Storyboard.TargetProperty="ScaleY" From="1" To="1.05" Duration="0:0:2"/>
            <DoubleAnimation Storyboard.TargetName="GridCanvas" Storyboard.TargetProperty="Opacity" From="0.5" To="0.8" Duration="0:0:2"/>
        </Storyboard>
    </UserControl.Resources>

    <Grid x:Name="MainGrid" Background="Transparent">
        <Grid.Projection>
            <PlaneProjection x:Name="ChartProjection" />
        </Grid.Projection>

        <!-- Background Particles -->
        <Canvas x:Name="ParticleCanvas" IsHitTestVisible="False"/>

        <Canvas x:Name="ChartCanvas" HorizontalAlignment="Center" VerticalAlignment="Center" Width="300" Height="300">
            <!-- Background Grid Group -->
            <Canvas x:Name="GridCanvas" Opacity="0.5">
                <Canvas.RenderTransform>
                    <ScaleTransform x:Name="GridScale" CenterX="150" CenterY="150"/>
                </Canvas.RenderTransform>
            </Canvas>

            <!-- Scanning Line -->
            <Grid Width="300" Height="300" IsHitTestVisible="False">
                <Rectangle x:Name="ScanLine" Width="150" Height="2" HorizontalAlignment="Right" VerticalAlignment="Center" RenderTransformOrigin="0,0.5" Margin="150,0,0,0">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#006366F1" Offset="0"/>
                            <GradientStop Color="#806366F1" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                    <Rectangle.RenderTransform>
                        <RotateTransform x:Name="ScanRotation" CenterX="0" CenterY="0" Angle="0"/>
                    </Rectangle.RenderTransform>
                </Rectangle>
            </Grid>
            
            <!-- Data Polygon -->
            <Polygon x:Name="DataPolygon" 
                     Fill="#4D6366F1" 
                     Stroke="#6366F1" 
                     StrokeThickness="2"/>
            
            <!-- Data Points -->
            <Canvas x:Name="PointsCanvas" />
            
            <!-- Labels -->
            <Canvas x:Name="LabelsCanvas" />
            
            <!-- Central Info Display -->
            <Grid Width="100" Height="40" Canvas.Left="100" Canvas.Top="130" IsHitTestVisible="False">
                <Border Background="#CC0A0E1A" CornerRadius="8" Padding="4" x:Name="InfoBorder" Opacity="0">
                    <TextBlock x:Name="InfoText" Text="Skill: 90%" Foreground="White" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                </Border>
            </Grid>
        </Canvas>
    </Grid>
</UserControl>
