<UserControl
    x:Class="Portfolio.Presentation.BugBlaster"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="250"
    d:DesignWidth="350">

    <Grid Background="#0D1117" CornerRadius="24">
        <!-- Game Layer -->
        <Canvas x:Name="GameCanvas" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent"/>

        <!-- Scanline Effect -->
        <Border IsHitTestVisible="False" Opacity="0.1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="Black" Offset="0"/>
                    <GradientStop Color="Transparent" Offset="0.5"/>
                    <GradientStop Color="Black" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- UI Overlay -->
        <Grid Padding="24" IsHitTestVisible="False">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <Border Background="#F97316" 
                        Width="44" Height="44" 
                        CornerRadius="12">
                    <TextBlock Text="N" 
                               FontSize="22" 
                               FontWeight="Bold" 
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="NotePage" 
                               FontSize="18" 
                               FontWeight="Bold" 
                               Foreground="White"/>
                    <TextBlock Text="DEBUG MODE: ACTIVE" 
                               FontSize="10" 
                               Foreground="#EF4444" 
                               FontWeight="Bold"
                               Opacity="0.8"/>
                </StackPanel>
            </Grid>

            <!-- Game Info / Description -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="4">
                <TextBlock x:Name="ScoreText" 
                           Text="BUGS SQUASHED: 0" 
                           FontSize="24" 
                           FontFamily="Consolas"
                           FontWeight="Bold" 
                           Foreground="#10B981"
                           HorizontalAlignment="Center"
                           Opacity="0.2"/>
                
                <TextBlock Text="Real-time content/code sharing app." 
                           FontSize="12" 
                           Foreground="#B8B8B8"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Left"
                           Margin="0,20,0,0"/>
            </StackPanel>

            <!-- Tags -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6">
                <Border Background="#2D3348" Padding="10,5" CornerRadius="6">
                    <TextBlock Text="ANGULAR" FontSize="9" Foreground="#B8B8B8"/>
                </Border>
                <Border Background="#2D3348" Padding="10,5" CornerRadius="6">
                    <TextBlock Text="MONGODB" FontSize="9" Foreground="#B8B8B8"/>
                </Border>
            </StackPanel>
        </Grid>
        
        <!-- Click Overlay for Game -->
        <Canvas x:Name="InteractionLayer" Background="Transparent" PointerPressed="OnGameCanvasPressed"/>
    </Grid>
</UserControl>
