<UserControl
    x:Class="Portfolio.Presentation.InteractiveProfile"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="420"
    d:DesignWidth="380">

    <Grid Background="Transparent">
        <Grid.Clip>
            <RectangleGeometry Rect="0,0,380,420"/>
        </Grid.Clip>

        <!-- Background Particles -->
        <Canvas x:Name="ParticleCanvas" IsHitTestVisible="False"/>

        <!-- Content Container with Parallax -->
        <Grid x:Name="ContentGrid" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="ContentTranslate"/>
            </Grid.RenderTransform>
            
            <StackPanel Spacing="16" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
                <!-- Avatar Section -->
                <Grid Width="120" Height="120" HorizontalAlignment="Center">
                    <!-- Rotating Rings -->
                    <Grid x:Name="RingsGrid" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <RotateTransform x:Name="RingsRotation" Angle="0"/>
                        </Grid.RenderTransform>
                        <Ellipse Width="120" Height="120" Stroke="#3B82F6" StrokeThickness="1" StrokeDashArray="4,2" Opacity="0.5"/>
                        <Ellipse Width="110" Height="110" Stroke="#10B981" StrokeThickness="1" StrokeDashArray="2,4" Opacity="0.3" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <RotateTransform Angle="45"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </Grid>

                    <!-- Profile Image -->
                    <Ellipse Width="100" Height="100">
                        <Ellipse.Fill>
                            <ImageBrush ImageSource="https://avatars.githubusercontent.com/u/80502833?v=4" Stretch="UniformToFill"/>
                        </Ellipse.Fill>
                    </Ellipse>
                    
                    <!-- Scanning Effect Overlay -->
                    <Grid x:Name="ScanGrid" Width="100" Height="100">
                        <Grid.Clip>
                            <RectangleGeometry Rect="0,0,100,100"/>
                        </Grid.Clip>
                        <Rectangle x:Name="ScanLine" Width="100" Height="2" Fill="#10B981" VerticalAlignment="Top" Opacity="0.8">
                            <Rectangle.RenderTransform>
                                <TranslateTransform Y="-100"/>
                            </Rectangle.RenderTransform>
                            <Rectangle.Shadow>
                                <ThemeShadow/>
                            </Rectangle.Shadow>
                        </Rectangle>
                        <Rectangle x:Name="ScanOverlay" Width="100" Height="100" Fill="#10B981" Opacity="0"/>
                    </Grid>
                </Grid>

                <!-- Text Info -->
                <StackPanel Spacing="8" HorizontalAlignment="Center">
                    <TextBlock Text="Varshith V Hegde" 
                               FontSize="28" 
                               FontWeight="Bold" 
                               Foreground="White"
                               TextAlignment="Center"
                               TextWrapping="Wrap"/>

                    <TextBlock Text="Full Stack &amp; Android Developer" 
                               FontSize="15" 
                               Foreground="#10B981"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               FontWeight="SemiBold"/>

                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE707;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#B8B8B8"/>
                        <TextBlock Text="Karnataka, India" FontSize="13" Foreground="#B8B8B8"/>
                    </StackPanel>
                </StackPanel>

                <TextBlock Text="Software engineer with 1.5+ years of experience. A simple programmer fond of learning who mixes code with creativity." 
                           FontSize="13" 
                           Foreground="#B8B8B8"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           LineHeight="20"
                           Opacity="0.8"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
