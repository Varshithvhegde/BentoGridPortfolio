<UserControl
    x:Class="Portfolio.Presentation.ParticleVortex"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="280"
    d:DesignWidth="380">

    <Grid Background="#0D1117">
        <Canvas x:Name="VortexCanvas" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
        
        <!-- Center Label -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
            <Border Background="#3B82F6" Width="40" Height="40" CornerRadius="20" HorizontalAlignment="Center" Margin="0,0,0,8">
                <FontIcon Glyph="&#xE896;" FontFamily="Segoe MDL2 Assets" Foreground="White" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="FreeShare" FontSize="16" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
            <TextBlock Text="Secure Transfer" FontSize="10" Foreground="#B8B8B8" HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</UserControl>
