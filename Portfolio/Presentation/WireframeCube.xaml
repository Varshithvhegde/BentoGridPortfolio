<UserControl
    x:Class="Portfolio.Presentation.WireframeCube"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="250"
    d:DesignWidth="250">

    <Grid Background="Transparent">
        <Canvas x:Name="CubeCanvas" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
        
        <!-- Overlay Info -->
        <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="20" IsHitTestVisible="False">
            <TextBlock Text="TouchReno" 
                       FontSize="18" 
                       FontWeight="Bold" 
                       Foreground="White"/>
            <TextBlock Text="AR Renovation App" 
                       FontSize="12" 
                       Foreground="#B8B8B8"/>
        </StackPanel>

        <!-- AR Badge -->
        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16"
                Background="#10B981" CornerRadius="4" Padding="6,2">
            <TextBlock Text="AR" FontSize="10" FontWeight="Bold" Foreground="White"/>
        </Border>
    </Grid>
</UserControl>
